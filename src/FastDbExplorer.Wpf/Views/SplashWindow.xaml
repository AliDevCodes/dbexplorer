<Window x:Class='FastDbExplorer.Wpf.Views.SplashWindow' xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        xmlns:l='clr-namespace:FastDbExplorer.Wpf.Localization'
        Title='{x:Static l:WindowStrings.AppName}' Icon='pack://application:,,,/Assets/app.ico'
        Width='760' Height='460' WindowStyle='None' AllowsTransparency='True' Background='Transparent'
        ResizeMode='NoResize' ShowInTaskbar='False' WindowStartupLocation='CenterScreen'
        UseLayoutRounding='True' FontFamily='{StaticResource AppFont}' Foreground='White'>
  <!-- Fixed dark design (same in light and dark theme). Canvas coordinates are absolute, so the layer is always left-to-right; only the Persian texts are right-to-left. -->
  <Grid Width='760' Height='460' FlowDirection='LeftToRight'>
    <Grid.Clip><RectangleGeometry Rect='0,0,760,460' RadiusX='20' RadiusY='20' /></Grid.Clip>
    <Canvas Width='760' Height='460' Background='#0A1020'>

      <!-- Glow behind the logo -->
      <Rectangle Width='760' Height='460'>
        <Rectangle.Fill>
          <RadialGradientBrush Center='0.5,0.32' GradientOrigin='0.5,0.32' RadiusX='0.375' RadiusY='0.62'>
            <GradientStop Color='#572F6BFF' Offset='0' />
            <GradientStop Color='#002F6BFF' Offset='1' />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- Faint map contour lines -->
      <Path Stroke='#0FFFFFFF' StrokeThickness='1.2' Data='M520 460c20-90 120-130 200-120s70 90 40 120' />
      <Path Stroke='#0FFFFFFF' StrokeThickness='1.2' Data='M470 460c30-120 160-180 290-160' />
      <Path Stroke='#0FFFFFFF' StrokeThickness='1.2' Data='M420 460c40-150 200-230 340-200' />
      <Path Stroke='#0FFFFFFF' StrokeThickness='1.2' Data='M-20 90c80-60 190-70 250-10s30 100-40 120-170-20-210-110z' />
      <Path Stroke='#0FFFFFFF' StrokeThickness='1.2' Data='M-20 40c110-80 250-90 330-10' />

      <!-- Three ripples that grow out of the logo (staggered by negative begin times) -->
      <Ellipse Canvas.Left='328' Canvas.Top='96' Width='104' Height='104' Stroke='#8C5B8CFF' StrokeThickness='1.5' Opacity='0' RenderTransformOrigin='0.5,0.5'>
        <Ellipse.RenderTransform><ScaleTransform ScaleX='1' ScaleY='1' /></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent='FrameworkElement.Loaded'>
            <BeginStoryboard>
              <Storyboard RepeatBehavior='Forever'>
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleX)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleY)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='Opacity' From='0.6' To='0' Duration='0:0:3.6' />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
      <Ellipse Canvas.Left='328' Canvas.Top='96' Width='104' Height='104' Stroke='#8C5B8CFF' StrokeThickness='1.5' Opacity='0' RenderTransformOrigin='0.5,0.5'>
        <Ellipse.RenderTransform><ScaleTransform ScaleX='1' ScaleY='1' /></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent='FrameworkElement.Loaded'>
            <BeginStoryboard>
              <Storyboard RepeatBehavior='Forever' BeginTime='-0:0:1.2'>
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleX)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleY)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='Opacity' From='0.6' To='0' Duration='0:0:3.6' />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
      <Ellipse Canvas.Left='328' Canvas.Top='96' Width='104' Height='104' Stroke='#8C5B8CFF' StrokeThickness='1.5' Opacity='0' RenderTransformOrigin='0.5,0.5'>
        <Ellipse.RenderTransform><ScaleTransform ScaleX='1' ScaleY='1' /></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent='FrameworkElement.Loaded'>
            <BeginStoryboard>
              <Storyboard RepeatBehavior='Forever' BeginTime='-0:0:2.4'>
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleX)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(ScaleTransform.ScaleY)' From='1' To='4.2' Duration='0:0:3.6' />
                <DoubleAnimation Storyboard.TargetProperty='Opacity' From='0.6' To='0' Duration='0:0:3.6' />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>

      <!-- Logo: database cylinder on a blue rounded square, drawn in a 96x96 box and scaled to 104 -->
      <Viewbox Canvas.Left='328' Canvas.Top='96' Width='104' Height='104'>
        <Viewbox.Effect><DropShadowEffect Color='#2F6BFF' Opacity='0.5' BlurRadius='28' ShadowDepth='12' Direction='270' /></Viewbox.Effect>
        <Canvas Width='96' Height='96'>
          <Rectangle Width='96' Height='96' RadiusX='26' RadiusY='26'>
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint='0,0' EndPoint='1,1'>
                <GradientStop Color='#3B7BFF' Offset='0' />
                <GradientStop Color='#1A3A9E' Offset='1' />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Path Stroke='White' StrokeThickness='3.6' StrokeStartLineCap='Round' StrokeEndLineCap='Round' StrokeLineJoin='Round'>
            <Path.Data>
              <GeometryGroup>
                <EllipseGeometry Center='48,32' RadiusX='22' RadiusY='8' />
                <PathGeometry Figures='M26 32v32M70 32v32M26 43c0 4.4 9.9 8 22 8s22-3.6 22-8M26 54c0 4.4 9.9 8 22 8s22-3.6 22-8M26 64c0 4.4 9.9 8 22 8s22-3.6 22-8' />
              </GeometryGroup>
            </Path.Data>
          </Path>
          <Ellipse Canvas.Left='37' Canvas.Top='28' Width='22' Height='8' Stroke='#FFC857' StrokeThickness='2.4' />
          <Ellipse Canvas.Left='44.4' Canvas.Top='28.4' Width='7.2' Height='7.2' Fill='#FFC857' />
        </Canvas>
      </Viewbox>

      <!-- Name and tagline -->
      <TextBlock Canvas.Top='224' Width='760' TextAlignment='Center' FlowDirection='LeftToRight' FontSize='32' FontWeight='Bold' Foreground='White'><Run Text='Fast' /><Run Text='Db' Foreground='#7AA2FF' /><Run Text='Explorer' /></TextBlock>
      <TextBlock Canvas.Top='272' Width='760' TextAlignment='Center' FlowDirection='RightToLeft' FontSize='15' Foreground='#9FB2D9' Text='{x:Static l:SplashStrings.Tagline}' />

      <!-- Progress bar (width follows the real start-up step) + status line -->
      <StackPanel Canvas.Top='346' Width='760'>
        <Grid Width='260' Height='4'>
          <Border CornerRadius='4' Background='#1FFFFFFF' />
          <Border x:Name='ProgressFill' HorizontalAlignment='Left' Width='0' CornerRadius='4' Background='#5B8CFF' ClipToBounds='True'>
            <Border Width='40' HorizontalAlignment='Left' Background='#8CFFFFFF'>
              <Border.Effect><BlurEffect Radius='4' /></Border.Effect>
              <Border.RenderTransform><TranslateTransform X='-40' /></Border.RenderTransform>
              <Border.Triggers>
                <EventTrigger RoutedEvent='FrameworkElement.Loaded'>
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior='Forever'>
                      <DoubleAnimation Storyboard.TargetProperty='(UIElement.RenderTransform).(TranslateTransform.X)' From='-40' To='260' Duration='0:0:1.6'>
                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode='EaseInOut' /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
            </Border>
          </Border>
        </Grid>
        <StackPanel Orientation='Horizontal' HorizontalAlignment='Center' Margin='0,10,0,0' FlowDirection='RightToLeft'>
          <TextBlock x:Name='StatusText' Margin='3,0' FontSize='12.5' Foreground='#9FB2D9' />
          <TextBlock x:Name='CounterText' Margin='3,0' FontSize='12.5' Foreground='#9FB2D9' FlowDirection='LeftToRight' />
        </StackPanel>
      </StackPanel>

      <!-- Footer -->
      <Grid Canvas.Left='28' Canvas.Bottom='20' Width='704' FlowDirection='RightToLeft'>
        <Grid.ColumnDefinitions><ColumnDefinition Width='*' /><ColumnDefinition Width='Auto' /></Grid.ColumnDefinitions>
        <TextBlock FontSize='12' Foreground='#7F92B8' Text='{x:Static l:SplashStrings.Footer}' />
        <TextBlock x:Name='VersionText' Grid.Column='1' FontSize='12' Foreground='#7F92B8' FlowDirection='LeftToRight' />
      </Grid>
    </Canvas>

    <!-- Thin outline drawn on top of everything -->
    <Border CornerRadius='20' BorderBrush='#1AFFFFFF' BorderThickness='1' IsHitTestVisible='False' />
  </Grid>
</Window>
