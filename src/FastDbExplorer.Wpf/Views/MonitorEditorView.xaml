<UserControl x:Class="FastDbExplorer.Wpf.Views.MonitorEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Width="760" HorizontalAlignment="Center" Margin="0,20,0,28">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" Margin="0,0,0,16" />

      <ProgressBar IsIndeterminate="True" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

      <TextBlock Text="{x:Static l:MonitoringStrings.Name}" Style="{StaticResource FieldLabel}" />
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

      <!-- Target table: chosen when creating, fixed when editing -->
      <Grid Margin="0,0,0,16" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="{x:Static l:MonitoringStrings.Database}" Style="{StaticResource FieldLabel}" />
          <ComboBox FlowDirection="LeftToRight" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="{x:Static l:MonitoringStrings.Table}" Style="{StaticResource FieldLabel}" />
          <ComboBox FlowDirection="LeftToRight" ItemsSource="{Binding Tables}" DisplayMemberPath="FullName" SelectedItem="{Binding SelectedTable}" />
        </StackPanel>
      </Grid>
      <StackPanel Margin="0,0,0,16" Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{x:Static l:MonitoringStrings.Target}" Style="{StaticResource FieldLabel}" />
        <TextBlock Text="{Binding TargetText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontWeight="SemiBold" />
      </StackPanel>

      <!-- Watermark column -->
      <TextBlock Text="{x:Static l:MonitoringStrings.WatermarkColumn}" Style="{StaticResource FieldLabel}" />
      <ComboBox FlowDirection="LeftToRight" MinWidth="260" HorizontalAlignment="Left" ItemsSource="{Binding WatermarkColumns}" SelectedItem="{Binding SelectedWatermark}"
                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{Binding SelectedWatermark}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontWeight="SemiBold"
                 Visibility="{Binding IsExisting, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{x:Static l:MonitoringStrings.WatermarkHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18" />

      <!-- Conditions -->
      <Border Style="{StaticResource Card}" Padding="16" CornerRadius="14" Margin="0,0,0,18">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static l:MonitoringStrings.Conditions}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="monitorLogic" Content="{x:Static l:Strings.MatchAll}" FontSize="12" IsChecked="{Binding MatchAll}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="monitorLogic" Content="{x:Static l:Strings.MatchAny}" FontSize="12" IsChecked="{Binding UseOr}" />
              </StackPanel>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{x:Static l:MonitoringStrings.AddCondition}" Command="{Binding AddFilterCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Filters}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox FlowDirection="LeftToRight" Margin="0,0,8,0"
                            ItemsSource="{Binding DataContext.FilterableColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedItem="{Binding Column}" />
                  <ComboBox Grid.Column="1" Margin="0,0,8,0"
                            ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedItem="{Binding SelectedOperator}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="2" FlowDirection="LeftToRight" Padding="10,8" ToolTip="{x:Static l:Strings.ValueTip}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}" />
                  <TextBox Grid.Column="3" FlowDirection="LeftToRight" Padding="10,8" Width="110" Margin="8,0,0,0" ToolTip="{x:Static l:Strings.Value2Tip}"
                           Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}"
                           Visibility="{Binding NeedsSecondValue, Converter={StaticResource BoolToVis}}" />
                  <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="4,0,0,0"
                          Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Schedule -->
      <TextBlock Text="{x:Static l:MonitoringStrings.Interval}" Style="{StaticResource FieldLabel}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <TextBox Width="110" FlowDirection="LeftToRight" Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{x:Static l:MonitoringStrings.IntervalHint}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>

      <!-- Report folder -->
      <TextBlock Text="{x:Static l:MonitoringStrings.OutputFolder}" Style="{StaticResource FieldLabel}" />
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox FlowDirection="LeftToRight" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Content="{x:Static l:MonitoringStrings.Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Padding="14,8" />
      </Grid>

      <CheckBox Content="{x:Static l:MonitoringStrings.PlaySound}" IsChecked="{Binding PlaySound}" Margin="0,0,0,20" />

      <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
        <Border.Style>
          <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
            <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:MonitoringStrings.Save}" Command="{Binding SaveCommand}" MinWidth="120" />
        <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" Margin="10,0,0,0" MinWidth="120" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
