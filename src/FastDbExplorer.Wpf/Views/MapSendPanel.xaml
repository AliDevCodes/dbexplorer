<UserControl x:Class="FastDbExplorer.Wpf.Views.MapSendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             x:Name="Root">
  <!--
    The ONE "show the selected rows on the map" panel, used by the Explorer and by the Monitoring result preview, so both look
    and behave the same: title + selection count, the two coordinate columns, one primary button that says what it will do
    (and is off with a reason shown below it), and the optional per-point details (collapsed by default).
    Everything is bound to dependency properties of this control (ElementName=Root), so each host binds its own view model.
  -->
  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14,12">
    <StackPanel>

      <!-- Title + how many rows are selected -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
          <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{x:Static l:MapSendStrings.Title}" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
        <Border Grid.Column="2" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCount, ElementName=Root}" Value="0"><Setter Property="Background" Value="Transparent" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding SelectionText, ElementName=Root}" FontSize="12" FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedCount, ElementName=Root}" Value="0"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>

      <!-- Coordinate columns + the one action -->
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="{x:Static l:MapSendStrings.Latitude}" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="190" FlowDirection="LeftToRight" ItemsSource="{Binding Columns, ElementName=Root}"
                    SelectedItem="{Binding LatitudeColumn, ElementName=Root, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{x:Static l:MapSendStrings.Longitude}" Style="{StaticResource FieldLabel}" />
          <ComboBox Width="190" FlowDirection="LeftToRight" ItemsSource="{Binding Columns, ElementName=Root}"
                    SelectedItem="{Binding LongitudeColumn, ElementName=Root, Mode=TwoWay}" />
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" MinWidth="170" VerticalAlignment="Bottom"
                Command="{Binding SendCommand, ElementName=Root}" IsEnabled="{Binding CanSend, ElementName=Root}"
                Content="{Binding SendText, ElementName=Root}" />
      </Grid>

      <!-- Why the button is off (or what to do first) -->
      <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding HasHint, ElementName=Root, Converter={StaticResource BoolToVis}}" />

      <!-- Optional details shown when the mouse is over a point on the map -->
      <Expander Margin="0,6,0,0">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static l:MapSendStrings.DetailsHeader}" />
            <TextBlock Text="{Binding DetailsCountText, ElementName=Root}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="{Binding DetailsNote, ElementName=Root}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="130">
            <ItemsControl ItemsSource="{Binding DetailColumns, ElementName=Root}" IsTabStop="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FlowDirection="LeftToRight" Margin="0,0,14,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
